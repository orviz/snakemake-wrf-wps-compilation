import os
import shutil

configfile: "config/config.yaml"

EESSI_INIT  = config["eessi_init_script"]
WRF_VER     = config["wrf_version"]
WPS_VER     = config["wps_version"]
TC_SUFFIX   = config["toolchain_suffix"]

WRF_INSTALL_DIR = config["wrf_install_dir"]
WPS_INSTALL_DIR = config["wps_install_dir"]

# ====================================================================
# COMPILATION ENGINE PATHS: Compilation engine paths for WPS and WRF
# ====================================================================
WPS_SUBDIR_TEMPLATE = config.get("engine_wps_subdir", "")
WRF_SUBDIR_TEMPLATE = config.get("engine_wrf_subdir", "")

ENGINE_WPS_SUBDIR = WPS_SUBDIR_TEMPLATE.format(wps_version=WPS_VER, toolchain_suffix=TC_SUFFIX)
ENGINE_WRF_SUBDIR = WRF_SUBDIR_TEMPLATE.format(wrf_version=WRF_VER, toolchain_suffix=TC_SUFFIX)

ENGINE_WPS_ROOT = f"{WPS_INSTALL_DIR}/{ENGINE_WPS_SUBDIR}".rstrip("/")
ENGINE_WRF_ROOT = f"{WRF_INSTALL_DIR}/{ENGINE_WRF_SUBDIR}".rstrip("/")

print(f"[DAG Initialize] Tuning pipeline using engine: {config.get('installation_engine', 'custom')}")

# =================================================================================================================
# TARGET RULE: Validate according to the presence of the executables in the installation directories
# =================================================================================================================
rule all:
    input:
        f"{WPS_INSTALL_DIR}/ungrib.exe",
        f"{WPS_INSTALL_DIR}/geogrid.exe",
        f"{WPS_INSTALL_DIR}/metgrid.exe",
        f"{WRF_INSTALL_DIR}/main/real.exe",
        f"{WRF_INSTALL_DIR}/main/wrf.exe"

# =============================================================================================
# AUDIT RULES: Verify the status of WPS and WRF installations and generate JSON reports
# =============================================================================================
rule audit_wps_status:
    output:
        json_report = "audit/WPS_status.json"
    params:
        eessi_init = EESSI_INIT,
        version    = WPS_VER,
        tc_suffix  = TC_SUFFIX,
        script     = workflow.source_path("scripts/audit.sh")
    threads: 1
    shell:
        """
        bash '{params.script}' \
            '{params.eessi_init}' \
            'WPS' \
            '{params.version}' \
            '{params.tc_suffix}' \
            '{output.json_report}'
        """

rule audit_wrf_status:
    output:
        json_report = "audit/WRF_status.json"
    params:
        eessi_init = EESSI_INIT,
        version    = WRF_VER,
        tc_suffix  = TC_SUFFIX,
        script     = workflow.source_path("scripts/audit.sh")
    threads: 1
    shell:
        """
        bash '{params.script}' \
            '{params.eessi_init}' \
            'WRF' \
            '{params.version}' \
            '{params.tc_suffix}' \
            '{output.json_report}'
        """

# =============================================================================================
# COMPILATION RULES: Compile WPS and WRF using EasyBuild recipes and generate executables
# =============================================================================================

rule compile_wps_via_eb:
    input:
        wps_json  = "audit/WPS_status.json",
        wrf_json  = "audit/WRF_status.json",
        wrf_ready = f"{ENGINE_WRF_ROOT}/main/wrf.exe",
    output:
        f"{ENGINE_WPS_ROOT}/geogrid.exe",
        f"{ENGINE_WPS_ROOT}/ungrib.exe",
        f"{ENGINE_WPS_ROOT}/metgrid.exe"
    log:
        "logs/compile_WPS.log"
    params:
        eessi_init   = EESSI_INIT,
        status_json  = "audit/WPS_status.json",
        local_recipe = os.path.abspath(f"config/WPS-{WPS_VER}{TC_SUFFIX}.eb"),
        install_dir  = WPS_INSTALL_DIR,
        script       = workflow.source_path("scripts/compile.sh")
    threads: 8
    shell:
        """
        set -x
        bash '{params.script}' \
            '{params.eessi_init}' \
            '{params.status_json}' \
            '{params.local_recipe}' \
            'WPS' \
            '{threads}' \
            '{params.install_dir}'
        """

rule compile_wrf_via_eb:
    input:
        wps_json = "audit/WPS_status.json",
        wrf_json = "audit/WRF_status.json"
    output:
        f"{ENGINE_WRF_ROOT}/main/real.exe",
        f"{ENGINE_WRF_ROOT}/main/wrf.exe"
    log:
        "logs/compile_WRF.log"
    params:
        eessi_init   = EESSI_INIT,
        status_json  = "audit/WRF_status.json",
        local_recipe = os.path.abspath(f"config/WRF-{WRF_VER}{TC_SUFFIX}.eb"),
        install_dir  = WRF_INSTALL_DIR,
        script       = workflow.source_path("scripts/compile.sh")
    threads: 8
    shell:
        """
        set -x
        bash '{params.script}' \
            '{params.eessi_init}' \
            '{params.status_json}' \
            '{params.local_recipe}' \
            'WRF' \
            '{threads}' \
            '{params.install_dir}'
        """

# =================================================================================================================
# LINKING RULES: Create symbolic links to the compiled WPS and WRF executables in the installation directories
# =================================================================================================================

rule create_wps_master_link:
    input:
        f"{ENGINE_WPS_ROOT}/geogrid.exe",
        f"{ENGINE_WPS_ROOT}/ungrib.exe",
        f"{ENGINE_WPS_ROOT}/metgrid.exe"
    output:
        f"{WPS_INSTALL_DIR}/geogrid.exe",
        f"{WPS_INSTALL_DIR}/ungrib.exe",
        f"{WPS_INSTALL_DIR}/metgrid.exe"
    run:
        target_dir = WPS_INSTALL_DIR

        if os.path.exists(target_dir) and not os.path.islink(target_dir):
            if os.path.isdir(target_dir):
                shutil.rmtree(target_dir)

        os.symlink(ENGINE_WPS_ROOT, target_dir)
        print(f" -> [Linking Success] WPS master link established: {target_dir} -> {ENGINE_WPS_ROOT}")

rule create_wrf_master_link:
    input:
        f"{ENGINE_WRF_ROOT}/main/real.exe",
        f"{ENGINE_WRF_ROOT}/main/wrf.exe"
    output:
        f"{WRF_INSTALL_DIR}/main/real.exe",
        f"{WRF_INSTALL_DIR}/main/wrf.exe"
    run:
        target_dir = WRF_INSTALL_DIR

        if os.path.exists(target_dir) and not os.path.islink(target_dir):
            if os.path.isdir(target_dir):
                shutil.rmtree(target_dir)

        os.symlink(ENGINE_WRF_ROOT, target_dir)
        print(f" -> [Linking Success] WRF master link established: {target_dir} -> {ENGINE_WRF_ROOT}")