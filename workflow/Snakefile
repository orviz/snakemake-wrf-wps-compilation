# workflow/Snakefile (Módulo de compilación - Corregido para 0.4.0-alpha3)
import os

configfile: "config/config.yaml"

EESSI_INIT  = config["eessi_init_script"]
WPS_VER     = config["wps_version"]
WRF_VER     = config["wrf_version"]
TC_SUFFIX   = config["toolchain_suffix"]

WPS_BIN_DIR = config.get("wps_bin_dir", "bin")
WRF_BIN_DIR = config.get("wrf_bin_dir", "bin")

rule all:
    input:
        f"{WPS_BIN_DIR}/ungrib.exe",
        f"{WRF_BIN_DIR}/wrf.exe"

# =========================================================================
# RULE 1: Dynamic Discovery of Central EESSI Repository State via eb -S
# =========================================================================
rule audit_eessi_status:
    output:
        json_report = "audit/{software}_status.json"
    params:
        eessi_init = EESSI_INIT,
        version    = lambda wildcards: WPS_VER if wildcards.software == "WPS" else WRF_VER,
        tc_suffix  = TC_SUFFIX
    threads: 1
    shell:
        """
        workflow/scripts/audit.sh \
            '{params.eessi_init}' \
            '{wildcards.software}' \
            '{params.version}' \
            '{params.tc_suffix}' \
            '{output.json_report}'
        """

# =========================================================================
# RULE 2: Intelligent Compilation and Dynamic Local Symlink Generation
# =========================================================================
rule compile_software_via_eb:
    input:
        wps_json = "audit/WPS_status.json",
        wrf_json = "audit/WRF_status.json",
        wrf_ready = lambda wildcards: f"{WRF_BIN_DIR}/wrf.exe" if wildcards.executable == "ungrib" else []
    output:
        real_binary = "{path}/{executable}.exe"
    log:
        "{path}/logs/compile_{executable}.log"
    wildcard_constraints:
        executable = "ungrib|wrf",
        path = "(?!logs/|audit/|logs$).*"
    params:
        eessi_init   = EESSI_INIT,
        status_json  = lambda wildcards: "audit/WRF_status.json" if wildcards.executable == "wrf" else "audit/WPS_status.json",
        local_recipe = lambda wildcards: os.path.abspath(f"config/{'WPS' if wildcards.executable == 'ungrib' else 'WRF'}-{WPS_VER if wildcards.executable == 'ungrib' else WRF_VER}{TC_SUFFIX}.eb"),
        marker_dir   = lambda wildcards, output: os.path.abspath(os.path.dirname(output.real_binary)),
        marker_abs   = lambda wildcards, output: os.path.abspath(output.real_binary)
    threads: 8
    shell:
        """
        set -x

        workflow/scripts/compile.sh \
            '{params.eessi_init}' \
            '{params.status_json}' \
            '{params.local_recipe}' \
            '{params.marker_dir}' \
            '{params.marker_abs}' \
            '{threads}'
        """