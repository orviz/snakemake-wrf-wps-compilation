import os
import shutil
from pathlib import Path

from snakemake.exceptions import WorkflowError

configfile: "config/config.yaml"

# =================================================================================
# 1. ENVIRONMENT CONFIG GATHERING: Carga inicial de variables globales
# =================================================================================
EESSI_INIT      = config["eessi_init_script"]
WRF_VER         = config["wrf_version"]
WPS_VER         = config["wps_version"]
WRF_INSTALL_DIR = config["wrf_install_dir"]
WPS_INSTALL_DIR = config["wps_install_dir"]

# ==========================================================================================================
# 2. COMPILATION ENGINE CONFIG VALIDATION: Verificación del motor de compilación seleccionado
# ==========================================================================================================
SUPPORTED_ENGINES = ["easybuild"]
ENGINE_TYPE = config.get("installation_engine", "easybuild").lower()

if ENGINE_TYPE not in SUPPORTED_ENGINES:
    raise WorkflowError(
        f"\n[ERROR] Installation engine '{ENGINE_TYPE}' is not supported.\n"
        f"Currently supported engines are: {SUPPORTED_ENGINES}\n"
    )

ENGINE_PARAMS = config.get(ENGINE_TYPE, {})

# =================================================================================
# 3. ENGINE PATH RESOLUTION: Construcción limpia de las subrutas del motor
# =================================================================================
if ENGINE_TYPE == "easybuild":
    TC_NAME = ENGINE_PARAMS.get("toolchain_name", "foss")
    TC_VER  = ENGINE_PARAMS.get("toolchain_version", "2024a")
    TC_TYPE = ENGINE_PARAMS.get("toolchain_type", "dmpar")

    TC_SUFFIX = f"-{TC_NAME}-{TC_VER}-{TC_TYPE}"

    WPS_SUBDIR_TEMPLATE = ENGINE_PARAMS.get("wps_subdir") or "software/WPS/{wps_version}-{toolchain_name}-{toolchain_version}-{toolchain_type}/WPS-{wps_version}"
    WRF_SUBDIR_TEMPLATE = ENGINE_PARAMS.get("wrf_subdir") or "software/WRF/{wrf_version}-{toolchain_name}-{toolchain_version}-{toolchain_type}/WRFV{wrf_version}"

    ENGINE_WPS_SUBDIR = WPS_SUBDIR_TEMPLATE.format(
        wps_version=WPS_VER,
        toolchain_name=TC_NAME,
        toolchain_version=TC_VER,
        toolchain_type=TC_TYPE
    )
    ENGINE_WRF_SUBDIR = WRF_SUBDIR_TEMPLATE.format(
        wrf_version=WRF_VER,
        toolchain_name=TC_NAME,
        toolchain_version=TC_VER,
        toolchain_type=TC_TYPE
    )

    ENGINE_WPS_ROOT = f".easybuild/{ENGINE_WPS_SUBDIR}".rstrip("/")
    ENGINE_WRF_ROOT = f".easybuild/{ENGINE_WRF_SUBDIR}".rstrip("/")

    config["toolchain_suffix"] = TC_SUFFIX
else:
    ENGINE_WPS_ROOT = ENGINE_PARAMS.get("wps_subdir", "").rstrip("/")
    ENGINE_WRF_ROOT = ENGINE_PARAMS.get("wrf_subdir", "").rstrip("/")

print(f"[DAG Initialize] Tuning pipeline using engine: {ENGINE_TYPE.upper()}")

# =================================================================================================================
# TARGET RULE: La regla maestra que exige las salidas de las reglas de enlace final
# =================================================================================================================
rule all:
    input:
        f"{WPS_INSTALL_DIR}/ungrib.exe",
        f"{WPS_INSTALL_DIR}/geogrid.exe",
        f"{WPS_INSTALL_DIR}/metgrid.exe",
        f"{WRF_INSTALL_DIR}/main/real.exe",
        f"{WRF_INSTALL_DIR}/main/wrf.exe"

# =============================================================================================
# AUDIT RULES: Verify the status of WPS and WRF installations and generate JSON reports
# =============================================================================================
rule audit_wps_status:
    output:
        json_report = "audit/WPS_status.json"
    params:
        eessi_init = EESSI_INIT,
        version    = WPS_VER,
        tc_suffix  = TC_SUFFIX,
        script     = workflow.source_path("scripts/audit.sh")
    threads: 1
    shell:
        """
        bash '{params.script}' \
            '{params.eessi_init}' \
            'WPS' \
            '{params.version}' \
            '{params.tc_suffix}' \
            '{output.json_report}'
        """

rule audit_wrf_status:
    output:
        json_report = "audit/WRF_status.json"
    params:
        eessi_init = EESSI_INIT,
        version    = WRF_VER,
        tc_suffix  = TC_SUFFIX,
        script     = workflow.source_path("scripts/audit.sh")
    threads: 1
    shell:
        """
        bash '{params.script}' \
            '{params.eessi_init}' \
            'WRF' \
            '{params.version}' \
            '{params.tc_suffix}' \
            '{output.json_report}'
        """

# =============================================================================================
# COMPILATION RULES: Compile WPS and WRF using EasyBuild recipes and generate executables
# =============================================================================================

rule compile_wrf_via_eb:
    input:
        wps_json = "audit/WPS_status.json",
        wrf_json = "audit/WRF_status.json"
    output:
        real_bin = f"{ENGINE_WRF_ROOT}/main/real.exe",
        wrf_bin  = f"{ENGINE_WRF_ROOT}/main/wrf.exe"
    log:
        "logs/compile_WRF.log"
    params:
        eessi_init   = EESSI_INIT,
        status_json  = "audit/WRF_status.json",
        local_recipe = os.path.abspath(f"config/WRF-{WRF_VER}{TC_SUFFIX}.eb"),
        install_dir  = os.path.abspath(".easybuild"),
        script       = workflow.source_path("scripts/compile.sh")
    threads: 8
    shell:
        """
        set -x
        bash '{params.script}' \
            '{params.eessi_init}' \
            '{params.status_json}' \
            '{params.local_recipe}' \
            'WRF' \
            '{threads}' \
            '{params.install_dir}'
        """

rule compile_wps_via_eb:
    input:
        wps_json  = "audit/WPS_status.json",
        wrf_json  = "audit/WRF_status.json",
        wrf_ready = f"{ENGINE_WRF_ROOT}/main/wrf.exe", # Espera al binario real del motor
    output:
        geogrid_bin = f"{ENGINE_WPS_ROOT}/geogrid.exe",
        ungrib_bin  = f"{ENGINE_WPS_ROOT}/ungrib.exe",
        metgrid_bin = f"{ENGINE_WPS_ROOT}/metgrid.exe"
    log:
        "logs/compile_WPS.log"
    params:
        eessi_init   = EESSI_INIT,
        status_json  = "audit/WPS_status.json",
        local_recipe = os.path.abspath(f"config/WPS-{WPS_VER}{TC_SUFFIX}.eb"),
        install_dir  = os.path.abspath(".easybuild"),
        script       = workflow.source_path("scripts/compile.sh")
    threads: 8
    shell:
        """
        set -x
        bash '{params.script}' \
            '{params.eessi_init}' \
            '{params.status_json}' \
            '{params.local_recipe}' \
            'WPS' \
            '{threads}' \
            '{params.install_dir}'
        """

# =================================================================================================================
# LINKING RULES: Create symbolic links to the compiled WPS and WRF executables in the installation directories
# =================================================================================================================

rule create_wps_master_link:
    input:
        geogrid_bin = f"{ENGINE_WPS_ROOT}/geogrid.exe",
        ungrib_bin  = f"{ENGINE_WPS_ROOT}/ungrib.exe",
        metgrid_bin = f"{ENGINE_WPS_ROOT}/metgrid.exe"
    output:
        f"{WPS_INSTALL_DIR}/geogrid.exe",
        f"{WPS_INSTALL_DIR}/ungrib.exe",
        f"{WPS_INSTALL_DIR}/metgrid.exe"
    run:
        from pathlib import Path
        import os
        import shutil

        target_dir = WPS_INSTALL_DIR

        if os.path.exists(target_dir) and not os.path.islink(target_dir):
            if os.path.isdir(target_dir):
                shutil.rmtree(target_dir)
        Path(target_dir).symlink_to(Path(ENGINE_WPS_ROOT), target_is_directory=True)

        print(f" -> [Linking Success] WPS master link established: {target_dir} -> {ENGINE_WPS_ROOT}")

rule create_wrf_master_link:
    input:
        real_bin = f"{ENGINE_WRF_ROOT}/main/real.exe",
        wrf_bin  = f"{ENGINE_WRF_ROOT}/main/wrf.exe"
    output:
        f"{WRF_INSTALL_DIR}/main/real.exe",
        f"{WRF_INSTALL_DIR}/main/wrf.exe"
    run:
        from pathlib import Path
        import os
        import shutil

        target_dir = WRF_INSTALL_DIR

        if os.path.exists(target_dir) and not os.path.islink(target_dir):
            if os.path.isdir(target_dir):
                shutil.rmtree(target_dir)
        Path(target_dir).symlink_to(Path(ENGINE_WRF_ROOT), target_is_directory=True)

        print(f" -> [Linking Success] WRF master link established: {target_dir} -> {ENGINE_WRF_ROOT}")